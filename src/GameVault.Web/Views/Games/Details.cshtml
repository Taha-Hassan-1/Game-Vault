@model GameVault.Application.Catalogue.GameDetails
@{
    ViewData["Title"] = Model.Title;
}

<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/games">Games</a></li><li class="breadcrumb-item active">@Model.Title</li></ol></nav>

<div class="row g-4">
    <div class="col-12 col-md-4">
        @if (!string.IsNullOrEmpty(Model.CoverUrl))
        {
            <img src="@Model.CoverUrl" class="img-fluid rounded-3" alt="Cover of @Model.Title" />
        }
        else
        {
            <div class="gv-cover gv-cover-fallback gv-cover-lg rounded-3" style="--gv-hue:@((Model.Id * 47) % 360)" aria-hidden="true">@Model.Title[0]</div>
        }
    </div>
    <div class="col-12 col-md-8">
        <h1 class="h2">@Model.Title @if (Model.IsStudioGame) { <span class="badge text-bg-primary align-middle fs-6">Studio game</span> }</h1>
        <div class="mb-2"><partial name="_Stars" model="@((Model.RatingAverage, Model.RatingCount))" /></div>
        <p class="text-body-secondary mb-3">
            @if (Model.ReleaseDate is { } d) { <span>Released @d.Year</span> }
        </p>
        <p>@Model.Description</p>

        <dl class="row mb-0">
            @if (Model.Genres.Count > 0)
            {
                <dt class="col-sm-3">Genres</dt>
                <dd class="col-sm-9">@foreach (var x in Model.Genres) { <a class="badge text-bg-secondary text-decoration-none me-1" href="/games?genre=@x.Slug">@x.Name</a> }</dd>
            }
            @if (Model.Platforms.Count > 0)
            {
                <dt class="col-sm-3">Platforms</dt>
                <dd class="col-sm-9">@foreach (var x in Model.Platforms) { <a class="badge text-bg-secondary text-decoration-none me-1" href="/games?platform=@x.Slug">@x.Name</a> }</dd>
            }
            @if (Model.Tags.Count > 0)
            {
                <dt class="col-sm-3">Tags</dt>
                <dd class="col-sm-9">@foreach (var x in Model.Tags) { <a class="badge text-bg-dark border text-decoration-none me-1" href="/games?tag=@x.Slug">@x.Name</a> }</dd>
            }
        </dl>
        @if (Model.IsRawg)
        {
            <p class="small text-body-secondary mt-3">Metadata from <a href="https://rawg.io" rel="noopener" target="_blank">RAWG</a>.</p>
        }
    </div>
</div>

@if (Model.Screenshots.Count > 0)
{
    <section class="mt-5">
        <h2 class="h4 mb-3">Screenshots</h2>
        <div class="row row-cols-2 row-cols-md-4 g-2">
            @foreach (var s in Model.Screenshots)
            {
                <div class="col"><img src="@s" class="img-fluid rounded-2" alt="Screenshot of @Model.Title" loading="lazy" /></div>
            }
        </div>
    </section>
}

<section class="mt-5">
    <h2 class="h4 mb-3">Reviews</h2>
    @if (Model.Reviews.Count == 0)
    {
        <p class="text-body-secondary">No reviews yet.</p>
    }
    else
    {
        foreach (var r in Model.Reviews)
        {
            <article class="border-bottom py-3">
                <div class="d-flex justify-content-between">
                    <strong>@r.AuthorName</strong>
                    <span class="gv-stars">@(new string('★', r.Stars))<span class="text-body-secondary">@(new string('★', 5 - r.Stars))</span></span>
                </div>
                <div class="small text-body-secondary">@r.CreatedAt.ToString("d MMM yyyy")@(r.EditedAt is not null ? " (edited)" : "")</div>
                <p class="mb-0 mt-2" style="white-space:pre-wrap">@r.Body</p>
            </article>
        }
    }
</section>

@await Component.InvokeAsync("SimilarGames", new { slug = Model.Slug })
