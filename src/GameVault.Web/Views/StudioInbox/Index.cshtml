@model GameVault.Web.Models.InboxViewModel
@using GameVault.Domain
@{
    ViewData["Title"] = "Feedback inbox";
    var f = Model.Filter;
    var here = Context.Request.Path + Context.Request.QueryString;
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Feedback inbox</h1>
    <a class="btn btn-sm btn-outline-secondary" asp-action="Export" asp-all-route-data="Model.PageRoute(1)">Export CSV</a>
</div>

<form method="get" action="/studio/inbox" class="row g-2 mb-4 align-items-end">
    <div class="col-6 col-md-3">
        <label class="form-label small" for="gameId">Game</label>
        <select id="gameId" name="gameId" class="form-select">
            <option value="">All</option>
            @foreach (var g in Model.Games) { <option value="@g.Id" selected="@(g.Id == f.GameId)">@g.Title</option> }
        </select>
    </div>
    <div class="col-6 col-md-3">
        <label class="form-label small" for="category">Category</label>
        <select id="category" name="category" class="form-select">
            <option value="">All</option>
            @foreach (var c in Enum.GetValues<FeedbackCategory>()) { <option value="@c" selected="@(c == f.Category)">@c</option> }
        </select>
    </div>
    <div class="col-6 col-md-2">
        <label class="form-label small" for="status">Status</label>
        <select id="status" name="status" class="form-select">
            <option value="">All</option>
            @foreach (var s in Enum.GetValues<FeedbackStatus>()) { <option value="@s" selected="@(s == f.Status)">@s</option> }
        </select>
    </div>
    <div class="col-6 col-md-2">
        <label class="form-label small" for="source">Source</label>
        <select id="source" name="source" class="form-select">
            <option value="">All</option>
            @foreach (var s in Enum.GetValues<FeedbackSource>()) { <option value="@s" selected="@(s == f.Source)">@s</option> }
        </select>
    </div>
    <div class="col-12 col-md-2 d-flex gap-2">
        <button class="btn btn-primary" type="submit">Filter</button>
        <a class="btn btn-outline-secondary" href="/studio/inbox">Reset</a>
    </div>
</form>

<p class="text-body-secondary">@Model.Result.TotalCount message@(Model.Result.TotalCount == 1 ? "" : "s")</p>

@if (Model.Result.Items.Count == 0)
{
    <div class="alert alert-secondary">No feedback matches those filters.</div>
}

@foreach (var m in Model.Result.Items)
{
    <article class="card mb-3 @(m.Status == FeedbackStatus.New ? "border-primary" : "")">
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between gap-2">
                <div>
                    <strong>@m.GameTitle</strong>
                    <span class="badge text-bg-secondary">@m.Category</span>
                    <span class="badge text-bg-dark border">@m.Source</span>
                    @if (m.AppVersion is not null) { <span class="badge text-bg-dark border">v@(m.AppVersion)</span> }
                    <span class="badge @(m.Status == FeedbackStatus.New ? "text-bg-primary" : "text-bg-secondary")">@m.Status</span>
                </div>
                <span class="small text-body-secondary">@m.CreatedAt.ToString("d MMM yyyy HH:mm") UTC@(m.PlayerRef is not null ? " · " + m.PlayerRef : "")</span>
            </div>
            <p class="mt-3 mb-3" style="white-space:pre-wrap">@m.Body</p>
            <div class="d-flex gap-2">
                @foreach (var target in Enum.GetValues<FeedbackStatus>().Where(s => s != m.Status))
                {
                    <form asp-controller="StudioInbox" asp-action="SetStatus" asp-route-id="@m.Id" method="post">
                        <input type="hidden" name="status" value="@target" />
                        <input type="hidden" name="returnUrl" value="@here" />
                        <button class="btn btn-sm btn-outline-secondary" type="submit">Mark @target.ToString().ToLowerInvariant()</button>
                    </form>
                }
            </div>
        </div>
    </article>
}

@if (Model.Result.TotalPages > 1)
{
    <nav class="mt-4" aria-label="Pages">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.Result.HasPrevious ? "" : "disabled")"><a class="page-link" asp-action="Index" asp-all-route-data="Model.PageRoute(Model.Result.Page - 1)">Previous</a></li>
            <li class="page-item disabled"><span class="page-link">Page @Model.Result.Page of @Model.Result.TotalPages</span></li>
            <li class="page-item @(Model.Result.HasNext ? "" : "disabled")"><a class="page-link" asp-action="Index" asp-all-route-data="Model.PageRoute(Model.Result.Page + 1)">Next</a></li>
        </ul>
    </nav>
}
