@model GameVault.Web.Models.StudioGameEditViewModel
@{
    ViewData["Title"] = Model.IsNew ? "New studio game" : "Edit " + Model.Form.Title;
    var form = Model.Form;
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">@(Model.IsNew ? "New studio game" : "Edit game")</h1>
    <a class="btn btn-outline-secondary btn-sm" href="/studio/games">Back to the list</a>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <form asp-controller="StudioGames" asp-action="@(Model.IsNew ? "New" : "Edit")" asp-route-id="@(Model.IsNew ? null : form.Id.ToString())" method="post">
            <div asp-validation-summary="All" class="alert alert-danger"></div>
            <div class="mb-3">
                <label asp-for="Form.Title" class="form-label"></label>
                <input asp-for="Form.Title" class="form-control" maxlength="300" />
            </div>
            <div class="mb-3">
                <label asp-for="Form.Description" class="form-label"></label>
                <textarea asp-for="Form.Description" class="form-control" rows="6" maxlength="8000"></textarea>
            </div>
            <div class="row">
                <div class="col-md-5 mb-3">
                    <label asp-for="Form.ReleaseDate" class="form-label"></label>
                    <input asp-for="Form.ReleaseDate" type="date" class="form-control" />
                </div>
                <div class="col-md-7 mb-3">
                    <label asp-for="Form.CoverUrl" class="form-label"></label>
                    <input asp-for="Form.CoverUrl" class="form-control" placeholder="https://… (or upload below)" />
                </div>
            </div>

            @{
                void Group(string label, string field, IReadOnlyList<GameVault.Application.Catalogue.TaxonItem> items, List<string> selected)
                {
                    <fieldset class="mb-3">
                        <legend class="form-label fs-6">@label</legend>
                        <div class="d-flex flex-wrap gap-3">
                            @foreach (var x in items)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="@field" id="@(field)-@x.Slug" value="@x.Slug" checked="@selected.Contains(x.Slug)" />
                                    <label class="form-check-label" for="@(field)-@x.Slug">@x.Name</label>
                                </div>
                            }
                        </div>
                    </fieldset>
                }
            }
            @{ Group("Genres", "Genres", Model.Facets.Genres, form.Genres); }
            @{ Group("Platforms", "Platforms", Model.Facets.Platforms, form.Platforms); }
            @{ Group("Tags", "Tags", Model.Facets.Tags, form.Tags); }

            @if (Model.Slug is not null)
            {
                <p class="small text-body-secondary">Address: <code>/games/@Model.Slug</code> (fixed once created).</p>
            }
            <button class="btn btn-primary" type="submit">@(Model.IsNew ? "Create game" : "Save changes")</button>
        </form>
    </div>

    @if (!Model.IsNew)
    {
        <div class="col-lg-5">
            <section class="mb-4">
                <h2 class="h5">Cover</h2>
                @if (!string.IsNullOrEmpty(form.CoverUrl)) { <img src="@form.CoverUrl" class="img-fluid rounded-2 mb-2" style="max-height:180px" alt="Current cover" /> }
                <form asp-controller="StudioGames" asp-action="UploadCover" asp-route-id="@form.Id" method="post" enctype="multipart/form-data" class="d-flex gap-2">
                    <input class="form-control form-control-sm" type="file" name="file" accept="image/png,image/jpeg,image/webp" required />
                    <button class="btn btn-sm btn-outline-primary" type="submit">Upload</button>
                </form>
                <div class="form-text">PNG, JPEG or WebP, up to 2 MB.</div>
            </section>

            <section>
                <h2 class="h5">Screenshots (@Model.Screenshots.Count / 8)</h2>
                <div class="row row-cols-2 g-2 mb-3">
                    @foreach (var s in Model.Screenshots)
                    {
                        <div class="col">
                            <img src="@s.Url" class="img-fluid rounded-2 mb-1" alt="Screenshot" loading="lazy" />
                            <form asp-controller="StudioGames" asp-action="RemoveScreenshot" asp-route-id="@form.Id" asp-route-shotId="@s.Id" method="post">
                                <button class="btn btn-sm btn-outline-danger w-100" type="submit">Remove</button>
                            </form>
                        </div>
                    }
                </div>
                @if (Model.Screenshots.Count < 8)
                {
                    <form asp-controller="StudioGames" asp-action="AddScreenshot" asp-route-id="@form.Id" method="post" enctype="multipart/form-data" class="d-flex gap-2">
                        <input class="form-control form-control-sm" type="file" name="file" accept="image/png,image/jpeg,image/webp" required />
                        <button class="btn btn-sm btn-outline-primary" type="submit">Add</button>
                    </form>
                }
                else
                {
                    <div class="form-text">The limit is 8. Remove one to add another.</div>
                }
            </section>
        </div>
    }
</div>
