@model GameVault.Application.Catalogue.GameCard
<a class="card gv-card h-100 text-decoration-none" asp-route="game" asp-route-slug="@Model.Slug">
    @if (!string.IsNullOrEmpty(Model.CoverUrl))
    {
        <img src="@ImageUrls.Resized(Model.CoverUrl, ImageUrls.Card)" data-fallback-src="@ImageUrls.FallbackFor(Model.CoverUrl, ImageUrls.Card)"
             class="card-img-top gv-cover gv-outline" alt="" loading="lazy" decoding="async" />
    }
    else
    {
        <div class="gv-cover gv-cover-fallback @Hue.Class(Model.Id)" aria-hidden="true">@Model.Title[0]</div>
    }
    <div class="card-body p-3">
        <h3 class="h6 card-title mb-1">@Model.Title</h3>
        <div class="small text-body-secondary">@string.Join(" · ", Model.Genres.Take(2))</div>
        <div class="small mt-2 d-flex justify-content-between align-items-center">
            <partial name="_Stars" model="@((Model.RatingAverage, Model.RatingCount))" />
            @if (Model.IsStudioGame) { <span class="badge text-bg-primary">Studio</span> }
        </div>
    </div>
</a>
