@model ErrorViewModel
@{
    ViewData["Title"] = Model.StatusCode == 404 ? "Page not found" : "Something went wrong";
}

<div class="text-center py-5">
    @if (Model.StatusCode == 404)
    {
        <h1 class="display-4">404</h1>
        <p class="lead">We could not find that page.</p>
    }
    else if (Model.StatusCode is >= 400 and < 500)
    {
        <h1 class="display-4">@Model.StatusCode</h1>
        <p class="lead">That request could not be completed.</p>
    }
    else
    {
        <h1 class="display-4">Something went wrong</h1>
        <p class="lead">It is on our side, and it has been logged. Please try again in a moment.</p>
    }

    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to the home page</a>
    <a class="btn btn-outline-secondary" href="/games">Browse games</a>

    @if (Model.ShowRequestId)
    {
        <p class="small text-body-secondary mt-4">Quote this reference if you contact us: <code>@Model.RequestId</code></p>
    }
</div>
