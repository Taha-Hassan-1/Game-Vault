@model GameVault.Web.Models.GameSectionModel
@if (Model.Games.Count > 0)
{
    <section class="mb-5">
        <div class="d-flex justify-content-between align-items-baseline mb-3">
            <h2 class="h4 mb-0">@Model.Title</h2>
            @if (Model.Link is not null) { <a href="@Model.Link">See all</a> }
        </div>
        <div class="row row-cols-2 row-cols-md-4 g-3">
            @foreach (var g in Model.Games)
            {
                <div class="col"><partial name="_GameCard" model="g" /></div>
            }
        </div>
    </section>
}
