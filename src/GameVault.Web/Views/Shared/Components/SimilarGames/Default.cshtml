@model IReadOnlyList<GameVault.Application.Catalogue.GameCard>
@if (Model.Count > 0)
{
    <section class="mt-5">
        <h2 class="h4 mb-3">Similar games</h2>
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-6 g-3">
            @foreach (var g in Model)
            {
                <div class="col"><partial name="_GameCard" model="g" /></div>
            }
        </div>
    </section>
}
