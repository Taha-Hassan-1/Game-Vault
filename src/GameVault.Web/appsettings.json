{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": { "GameVault": "" },
  "Database": { "MigrateOnStart": false },
  "Rawg": {
    "Enabled": false,
    "ApiKey": "",
    "BaseAddress": "https://api.rawg.io/api/",
    "PageSize": 40,
    "StaleAfterDays": 30
  },
  "SyncBudget": {
    "MonthlyLimit": 20000,
    "SyncLimit": 15000,
    "PagesPerRun": 5,
    "RefreshPerRun": 50
  }
}
