<Project Sdk="Microsoft.NET.Sdk">

  <!-- Browser smoke tests. Deliberately NOT in GameVault.slnx: the Playwright package is large and the normal CI run does
       not need it. Run them with:  $env:GAMEVAULT_SMOKE = "1"; dotnet test tests/GameVault.Smoke -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Microsoft.Playwright" Version="1.*" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GameVault.Web\GameVault.Web.csproj" />
    <ProjectReference Include="..\..\src\GameVault.Infrastructure\GameVault.Infrastructure.csproj" />
  </ItemGroup>

</Project>
